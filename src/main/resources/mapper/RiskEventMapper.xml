<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.safebank.dao.RiskEventMapper">
    <resultMap id="row" type="cn.safebank.entity.RiskEventEntity">
        <id column="id" property="id"/>
        <result column="request_id" property="requestId"/>
        <result column="user_id" property="userId"/>
        <result column="action_id" property="actionId"/>
        <result column="decision_id" property="decisionId"/>
        <result column="event_code" property="eventCode"/>
        <result column="reason_code" property="reasonCode"/>
        <result column="channel" property="channel"/>
        <result column="policy_version" property="policyVersion"/>
        <result column="recorded_at" property="recordedAt"/>
    </resultMap>
    <sql id="columns">id,request_id,user_id,action_id,decision_id,event_code,reason_code,channel,policy_version,recorded_at</sql>
    <select id="selectOwned" resultMap="row">SELECT <include refid="columns"/> FROM risk_events WHERE id=#{id} AND user_id=#{userId}</select>
    <select id="selectOwnedForUpdate" resultMap="row">SELECT <include refid="columns"/> FROM risk_events WHERE id=#{id} AND user_id=#{userId} FOR UPDATE</select>
    <select id="selectByUser" resultMap="row">SELECT <include refid="columns"/> FROM risk_events WHERE user_id=#{userId} ORDER BY id</select>
    <insert id="insert">INSERT INTO risk_events(id,request_id,user_id,action_id,decision_id,event_code,reason_code,channel,policy_version,recorded_at) VALUES(#{id},#{requestId},#{userId},#{actionId},#{decisionId},#{eventCode},#{reasonCode},#{channel},#{policyVersion},#{recordedAt})</insert>
</mapper>
