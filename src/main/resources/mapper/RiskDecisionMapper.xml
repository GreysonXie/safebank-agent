<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.safebank.dao.RiskDecisionMapper">
    <resultMap id="row" type="cn.safebank.entity.RiskDecisionEntity">
        <id column="id" property="id"/>
        <result column="action_id" property="actionId"/>
        <result column="user_id" property="userId"/>
        <result column="revision" property="revision"/>
        <result column="policy_version" property="policyVersion"/>
        <result column="risk_level" property="riskLevel"/>
        <result column="required_assurance" property="requiredAssurance"/>
        <result column="reason_code" property="reasonCode"/>
        <result column="business_date" property="businessDate"/>
        <result column="amount_minor" property="amountMinor"/>
        <result column="effective_minor" property="effectiveMinor"/>
        <result column="projected_minor" property="projectedMinor"/>
        <result column="payload_hash" property="payloadHash"/>
        <result column="created_at" property="createdAt"/>
        <result column="valid_until" property="validUntil"/>
    </resultMap>
    <sql id="columns">id,action_id,user_id,revision,policy_version,risk_level,required_assurance,reason_code,business_date,amount_minor,effective_minor,projected_minor,payload_hash,created_at,valid_until</sql>
    <select id="selectOwned" resultMap="row">SELECT <include refid="columns"/> FROM risk_decisions WHERE id=#{id} AND user_id=#{userId}</select>
    <select id="selectOwnedForUpdate" resultMap="row">SELECT <include refid="columns"/> FROM risk_decisions WHERE id=#{id} AND user_id=#{userId} FOR UPDATE</select>
    <select id="selectByUser" resultMap="row">SELECT <include refid="columns"/> FROM risk_decisions WHERE user_id=#{userId} ORDER BY id</select>
    <select id="selectByAction" resultMap="row">SELECT <include refid="columns"/> FROM risk_decisions WHERE user_id=#{userId} AND action_id=#{actionId} ORDER BY revision DESC</select>
    <insert id="insert">INSERT INTO risk_decisions(id,action_id,user_id,revision,policy_version,risk_level,required_assurance,reason_code,business_date,amount_minor,effective_minor,projected_minor,payload_hash,created_at,valid_until) VALUES(#{id},#{actionId},#{userId},#{revision},#{policyVersion},#{riskLevel},#{requiredAssurance},#{reasonCode},#{businessDate},#{amountMinor},#{effectiveMinor},#{projectedMinor},#{payloadHash},#{createdAt},#{validUntil})</insert>
</mapper>
