<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.safebank.dao.ActionAuthorizationMapper">
    <update id="bindScheduleDelegation">UPDATE action_authorizations SET method='SCHEDULE_DELEGATION' WHERE user_id=#{userId} AND id=#{id} AND status='ACTIVE' AND method='USER_CONFIRM' AND assurance='CONFIRMED' AND challenge_id IS NULL</update>
    <resultMap id="row" type="cn.safebank.entity.ActionAuthorizationEntity">
        <id column="id" property="id"/>
        <result column="action_id" property="actionId"/>
        <result column="user_id" property="userId"/>
        <result column="decision_id" property="decisionId"/>
        <result column="challenge_id" property="challengeId"/>
        <result column="payload_hash" property="payloadHash"/>
        <result column="policy_version" property="policyVersion"/>
        <result column="business_date" property="businessDate"/>
        <result column="method" property="method"/>
        <result column="assurance" property="assurance"/>
        <result column="status" property="status"/>
        <result column="authorized_at" property="authorizedAt"/>
        <result column="expires_at" property="expiresAt"/>
    </resultMap>
    <sql id="columns">id,action_id,user_id,decision_id,challenge_id,payload_hash,policy_version,business_date,method,assurance,status,authorized_at,expires_at</sql>
    <select id="selectOwned" resultMap="row">SELECT <include refid="columns"/> FROM action_authorizations WHERE id=#{id} AND user_id=#{userId}</select>
    <select id="selectOwnedForUpdate" resultMap="row">SELECT <include refid="columns"/> FROM action_authorizations WHERE id=#{id} AND user_id=#{userId} FOR UPDATE</select>
    <select id="selectByUser" resultMap="row">SELECT <include refid="columns"/> FROM action_authorizations WHERE user_id=#{userId} ORDER BY id</select>
    <select id="selectByAction" resultMap="row">SELECT <include refid="columns"/> FROM action_authorizations WHERE user_id=#{userId} AND action_id=#{actionId} ORDER BY authorized_at DESC,id</select>
    <insert id="insert">INSERT INTO action_authorizations(id,action_id,user_id,decision_id,challenge_id,payload_hash,policy_version,business_date,method,assurance,status,authorized_at,expires_at) VALUES(#{id},#{actionId},#{userId},#{decisionId},#{challengeId},#{payloadHash},#{policyVersion},#{businessDate},#{method},#{assurance},#{status},#{authorizedAt},#{expiresAt})</insert>
    <update id="update">UPDATE action_authorizations SET challenge_id=#{challengeId},business_date=#{businessDate},assurance=#{assurance},status=#{status},expires_at=#{expiresAt} WHERE id=#{id} AND user_id=#{userId}</update>
</mapper>
