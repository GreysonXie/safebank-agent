# Generate local .env: python deployment/configure.py
# Do not commit your actual credentials.
MYSQL_ROOT_PASSWORD=REPLACE_WITH_LOCAL_RANDOM_PASSWORD
SAFEBANK_MODEL_MODE=mock
DEEPSEEK_API_KEY=
SAFEBANK_MODEL_NAME=deepseek-flash
# For an OpenAI-compatible gateway, set mode=openai and fill these locally.
SAFEBANK_MODEL_URL=https://api.deepseek.com
SAFEBANK_MODEL_API_KEY=
# Cumulative provider requests, 1..100000; failures count; restarting never resets usage.
SAFEBANK_MODEL_SMOKE_CAP=20
SAFEBANK_WEB_PORT=8134
