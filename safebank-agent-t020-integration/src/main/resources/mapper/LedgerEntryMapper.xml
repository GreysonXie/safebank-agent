<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.safebank.dao.LedgerEntryMapper">
    <resultMap id="row" type="cn.safebank.entity.LedgerEntryEntity">
        <id column="id" property="id"/>
        <result column="action_id" property="actionId"/>
        <result column="account_id" property="accountId"/>
        <result column="amount_minor" property="amountMinor"/>
    </resultMap>

    <insert id="insert">INSERT INTO ledger(id,action_id,account_id,amount_minor) VALUES(#{id},#{actionId},#{accountId},#{amountMinor})</insert>
    <select id="selectByAction" resultMap="row">SELECT id,action_id,account_id,amount_minor FROM ledger WHERE action_id=#{actionId}</select>
</mapper>
