  "constraints": [
    "bank_cards|ck_card_limits|CHECK|((`per_transaction_limit_minor` > 0) and (`daily_limit_minor` >= `per_transaction_limit_minor`) and (`daily_limit_minor` <= 10000000))|YES",
    "bank_cards|ck_card_status|CHECK|(`status` in (_utf8mb4\\'ACTIVE\\',_utf8mb4\\'LOCKED\\',_utf8mb4\\'LOST\\'))|YES",
    "bank_cards|ck_card_type|CHECK|(`card_type` in (_utf8mb4\\'DEBIT\\',_utf8mb4\\'VIRTUAL\\'))|YES",
    "bank_cards|ck_card_version|CHECK|(`version` >= 1)|YES",
    "bank_cards|PRIMARY|PRIMARY KEY||YES",
    "card_operations|ck_card_operation_kind|CHECK|(`kind` in (_utf8mb4\\'APPLY\\',_utf8mb4\\'UPDATE_LIMITS\\',_utf8mb4\\'UPDATE_CONTROLS\\',_utf8mb4\\'LOCK\\',_utf8mb4\\'UNLOCK\\',_utf8mb4\\'REPORT_LOST\\'))|YES",
    "card_operations|ck_card_operation_status|CHECK|(`status` in (_utf8mb4\\'AWAITING_CONFIRMATION\\',_utf8mb4\\'COMPLETED\\',_utf8mb4\\'CANCELLED\\'))|YES",
    "card_operations|PRIMARY|PRIMARY KEY||YES",
    "recipient_details|ck_contact_gender|CHECK|(`gender` in (_utf8mb4\\'UNKNOWN\\',_utf8mb4\\'MALE\\',_utf8mb4\\'FEMALE\\',_utf8mb4\\'UNDISCLOSED\\'))|YES",
    "recipient_details|PRIMARY|PRIMARY KEY||YES",
    "user_profiles|ck_profile_gender|CHECK|(`gender` in (_utf8mb4\\'UNKNOWN\\',_utf8mb4\\'MALE\\',_utf8mb4\\'FEMALE\\',_utf8mb4\\'UNDISCLOSED\\'))|YES",
    "user_profiles|PRIMARY|PRIMARY KEY||YES"
  ],
  "keys": [
    "bank_cards|PRIMARY|1|id||",
    "card_operations|PRIMARY|1|id||",
    "recipient_details|PRIMARY|1|recipient_id||",
    "user_profiles|PRIMARY|1|user_id||"
  ]
